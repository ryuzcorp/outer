# Outer production env. Copy to /srv/outer/outer.env on the VPS, fill the
# blanks, `chmod 600` it. Every variable outer reads in production, one line
# each; unset entries fall back to the dev default shown. Secrets stay blank
# here by design — never commit the filled file.
#
# The sibling TLS slice renames OUTER_HTTP_LISTEN to OUTER_LISTEN and adds
# the three TLS variables; this file already uses the new names.

# Platform host; apps live at <slug>.<domain>.
OUTER_DOMAIN=outer.now
# App host parent; default is OUTER_DOMAIN (escape hatch for §12.5: move apps
# to a second domain with one change).
#OUTER_APPS_DOMAIN=outer.now
# Listener. Prod binds all interfaces on 443; the host firewall admits only
# Cloudflare (deploy/firewall.sh). Default 127.0.0.1:8080.
OUTER_LISTEN=0.0.0.0:443
# Cloudflare Origin CA certificate (PEM) presented to visitors via Cloudflare.
OUTER_TLS_CERT=/tls/origin.pem
# Matching private key (PEM). Never leaves the VPS.
OUTER_TLS_KEY=/tls/origin.key
# Authenticated Origin Pulls CA (PEM): outer requires a Cloudflare client
# certificate signed by this CA on every connection (mTLS, no exceptions).
OUTER_ORIGIN_PULL_CA=/tls/origin-pull-ca.pem
# SQLite, git mirrors, worktrees, caches. Default ./data.
OUTER_DATA=/data
# Snapshot owner fence identity. Default is /etc/hostname.
#OUTER_HOST_ID=outer-vps
# r2 (prod) or memory (dev only; refused off localhost since apps vanish on
# restart). Default r2.
OUTER_STORE=r2
# R2 endpoint: https://<account_id>.eu.r2.cloudflarestorage.com (EU
# jurisdiction). Must be https off localhost. No default.
OUTER_R2_ENDPOINT=
# Region passport for S3 signing; R2 wants the literal `auto`. Default auto.
OUTER_R2_REGION=auto
# Bucket holding git bundles, snapshots, app storage. Default outer.
OUTER_R2_BUCKET=outer
# Parent R2 token (S3 API token), held by outer only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Log filter directives. Default info.
RUST_LOG=info
# Two loopback ports per fleet, inclusive lo-hi. Must hold at least two ports
# (one app). Default 20000-29999.
OUTER_FLEET_PORTS=20000-29999
# One uid per app, inclusive; the image pre-creates 200000-201023, so widening
# this needs a matching Dockerfile change. Default 200000-201023.
OUTER_APP_UID_RANGE=200000-201023
# Seconds of no requests before an app's fleet is stopped. Default 1800.
OUTER_SLEEP_AFTER_S=1800
# Binaries handed to celld; resolved against PATH, explicit paths pass
# through. Defaults celld, bun (both in the image's PATH).
#OUTER_CELLD_BIN=celld
#OUTER_BUN_BIN=bun
# esbuild for celld Worker bundling; unset uses celld's own. The image
# carries /usr/local/bin/esbuild.
#OUTER_ESBUILD_BIN=/usr/local/bin/esbuild
# Global concurrent builds; default is half the host CPUs, minimum 1.
#OUTER_BUILD_CONCURRENCY=
# Concurrent cold starts. Default 4.
OUTER_WAKE_CONCURRENCY=4
# Per-fleet memory.max in MiB; minimum 64. Default 512.
OUTER_FLEET_MEMORY_MB=512
# Per-fleet cpu.max, cgroup v2 "<quota> <period>" or "max <period>".
OUTER_FLEET_CPU_MAX=50000 100000
