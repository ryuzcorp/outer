# Outer production env. Copy to /srv/outer/outer.env on the VPS, fill the
# blanks, `chmod 600` it. Every variable outer reads in production, one line
# each; unset entries fall back to the dev default shown. Secrets stay blank
# here by design — never commit the filled file.

# Platform host; apps live at <slug>.<domain>.
OUTER_DOMAIN=outer.now
# App host parent; default is OUTER_DOMAIN (escape hatch for §12.5: move apps
# to a second domain with one change).
#OUTER_APPS_DOMAIN=outer.now
# Sign-up gate: closed (beta allowlist + waitlist) or open. Default closed.
#OUTER_SIGNUP=closed
# Admin emails, comma-separated (lowercased). Their tools/list adds admin tools.
#OUTER_ADMIN_EMAILS=
# Terms version users accept at first sign-in; changing it re-asks everyone
# at next sign-in. Required off localhost; dev default "dev".
#OUTER_TERMS_VERSION=
# Sign-in codes go through Cloudflare Email Service, reusing the CLOUDFLARE
# pair below (no extra secret). On localhost without the pair the code is
# logged instead of emailed.
#OUTER_EMAIL_FROM=Outer <hello@outer.now>
# OAuth token lifetimes: access seconds (default 3600), refresh days (default 90).
#OUTER_OAUTH_ACCESS_TTL_S=3600
#OUTER_OAUTH_REFRESH_TTL_D=90
# Awaited tool calls (commit/create_app/rollback wait, deploy_status wait)
# return the in-progress status after this many seconds. Default 50.
#OUTER_TOOL_WAIT_S=50
# Listener. Prod binds all interfaces on 443, dual stack (Cloudflare reaches
# the origin over IPv4 and IPv6); the host firewall admits only Cloudflare
# (deploy/firewall.sh). Default 127.0.0.1:8080.
OUTER_LISTEN=[::]:443
# Cloudflare Origin CA certificate (PEM) presented to visitors via Cloudflare.
OUTER_TLS_CERT=/tls/origin.pem
# Matching private key (PEM). Never leaves the VPS.
OUTER_TLS_KEY=/tls/origin.key
# Authenticated Origin Pulls CA (PEM): outer requires a Cloudflare client
# certificate signed by this CA on every connection (mTLS, no exceptions).
OUTER_ORIGIN_PULL_CA=/tls/origin-pull-ca.pem
# SQLite, git mirrors, worktrees, caches. Default ./data.
OUTER_DATA=/data
# Snapshot owner fence identity. Default is /etc/hostname.
#OUTER_HOST_ID=outer-vps
# r2 (prod) or memory (dev only; refused off localhost since apps vanish on
# restart). Default r2.
OUTER_STORE=r2
# R2 endpoint: https://<account_id>.eu.r2.cloudflarestorage.com (EU
# jurisdiction). Must be https off localhost. No default.
OUTER_R2_ENDPOINT=
# Region for S3 signing; R2 wants the literal `auto`. Default auto.
OUTER_R2_REGION=auto
# Bucket holding git bundles, snapshots, app storage. Default outer.
OUTER_R2_BUCKET=outer
# Parent R2 token (S3 API token), held by outer only. Fleets and deploys
# never see these: with the Cloudflare pair below they mint scoped temporary
# credentials per spawn/deploy (spec §12.6); without the pair outer runs
# only on localhost dev.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare account + API token (R2 temporary credentials, cache purge,
# custom hostnames). Both set → fleets/deploys get prefix-scoped credentials;
# both empty → localhost dev only (boot refuses off localhost); one of two →
# boot refuses everywhere, so a half-copied pair fails loud.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Zone for cache purge (deploys and rollbacks purge <slug>.<apps-domain>
# after going live; delete_app purges it on delete) and custom hostnames.
# Empty skips the purge at debug (localhost dev).
#CLOUDFLARE_ZONE_ID=
# Minted credential lifetime in seconds, 3600–604800. Default 604800 (7 days,
# Cloudflare's max). Fleets older than TTL minus a day (at least TTL/2) are
# gracefully restarted with fresh credentials before they expire.
#OUTER_R2_CREDENTIAL_TTL_S=604800
# Stripe billing (spec §14.2): secret + webhook secret + Pro price enable
# checkout, the customer portal and the webhook; all empty → billing
# disabled (localhost dev only; boot refuses off localhost). The launch
# coupon is optional: set → 50 % launch price at checkout; unset → promo
# over (existing subscribers keep their couponed price).
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_PRO=
#STRIPE_LAUNCH_COUPON=
# Log filter directives. Default info.
RUST_LOG=info
# Two loopback ports per fleet, inclusive lo-hi. Must hold at least two ports
# (one app). Default 20000-29999.
OUTER_FLEET_PORTS=20000-29999
# One uid per app, inclusive; the image pre-creates 200000-201023, so widening
# this needs a matching Dockerfile change. Default 200000-201023.
OUTER_APP_UID_RANGE=200000-201023
# Seconds of no requests before an app's fleet is stopped. Default 1800.
OUTER_SLEEP_AFTER_S=1800
# Binaries handed to celld; resolved against PATH, explicit paths pass
# through. Defaults celld, bun (both in the image's PATH).
#OUTER_CELLD_BIN=celld
#OUTER_BUN_BIN=bun
# esbuild for celld Worker bundling; unset uses celld's own. The image
# carries /usr/local/bin/esbuild.
#OUTER_ESBUILD_BIN=/usr/local/bin/esbuild
# Platform oxfmt binary that formats agent commits (js/ts/json/css/md…).
# The image carries /usr/local/bin/oxfmt; missing at runtime skips
# formatting and commits still work. Default /usr/local/bin/oxfmt.
#OUTER_OXFMT_BIN=/usr/local/bin/oxfmt
# Global concurrent builds; default is half the host CPUs, minimum 1.
#OUTER_BUILD_CONCURRENCY=
# Concurrent cold starts. Default 4.
OUTER_WAKE_CONCURRENCY=4
# Per-fleet memory.max in MiB; minimum 64. Default 512.
OUTER_FLEET_MEMORY_MB=512
# Per-fleet cpu.max, cgroup v2 "<quota> <period>" or "max <period>".
OUTER_FLEET_CPU_MAX=50000 100000
